# Frontend — public values only; never put GEMINI_API_KEY here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Optional override; normally derived automatically from VITE_SUPABASE_URL.
# VITE_EDGE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

# Supabase Secrets (set with `supabase secrets set`, never in this file):
# PaddleOCR HTTP service URL; keep server-side in Supabase Secrets.
# PADDLEOCR_URL=https://your-private-ocr-service.example/ocr
# PADDLEOCR_SERVICE_TOKEN=...
# OpenRouter is used only when PaddleOCR is unavailable or uncertain.
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
# OPENROUTER_FALLBACK_MODELS=
# CBR_API_URL=https://www.cbr.ru/scripts/XML_daily.asp
# Optional official VTB quote JSON endpoint, if your VTB region/account exposes one.
# Otherwise the backend parses the public VTB yuan page.
# VTB_RATES_API_URL=

# Deploy these functions after applying supabase/schema.sql:
# analyze-car-plate
# get-vtb-cny-rate
# get-cbr-eur-rate
# refresh-exchange-rates
